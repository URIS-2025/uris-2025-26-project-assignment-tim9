{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/notifications/{**catch-all}" }
      },
      "integration-route": {
        "ClusterId": "integration-cluster",
        "Match": { "Path": "/integrations/{**catch-all}" }
      },
      "project-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/project/{**catch-all}" }
      },
      "milestone-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/milestone/{**catch-all}" }
      },
      "projectmember-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/projectmember/{**catch-all}" }
      },
      "requirements-route": {
        "ClusterId": "project-cluster",
        "Match": { "Path": "/api/requirements/{**catch-all}" }
      },
      "sprint-route": {
        "ClusterId": "sprint-cluster",
        "Match": { "Path": "/sprints/{**catch-all}" }
      },
      "sprint-project-route": {
        "ClusterId": "sprint-cluster",
        "Match": { "Path": "/projects/{projectId}/sprints" }
      },
      "timelog-route": {
        "ClusterId": "timelog-cluster",
        "Match": { "Path": "/api/timelog/{**catch-all}" }
      },
      "workpackage-route": {
        "ClusterId": "workpackage-cluster",
        "Match": { "Path": "/api/workpackage/{**catch-all}" }
      },
      "task-route": {
        "ClusterId": "workpackage-cluster",
        "Match": { "Path": "/api/task/{**catch-all}" }
      },
      "comment-route": {
        "ClusterId": "workpackage-cluster",
        "Match": { "Path": "/api/comment/{**catch-all}" }
      },
      "dependency-route": {
        "ClusterId": "workpackage-cluster",
        "Match": { "Path": "/api/dependency/{**catch-all}" }
      },
      "backlog-route": {
        "ClusterId": "workpackage-cluster",
        "Match": { "Path": "/api/backlog/{**catch-all}" }
      },
      "attachment-route": {
        "ClusterId": "attachment-cluster",
        "Match": { "Path": "/attachments/{**catch-all}" }
      },
      "attachment-task-route": {
        "ClusterId": "attachment-cluster",
        "Match": { "Path": "/tasks/{taskId}/attachments" }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/user/{**catch-all}" }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/payments/{**catch-all}" }
      },
      "invoice-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/invoices/{**catch-all}" }
      }
    },
    "Clusters": {
      "notification-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5100/" }
        }
      },
      "integration-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5110/" }
        }
      },
      "project-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5230/" }
        }
      },
      "sprint-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5130/" }
        }
      },
      "timelog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5273/" }
        }
      },
      "workpackage-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5037/" }
        }
      },
      "attachment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5278/" }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5232/" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5231/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5240/" }
        }
      }
    }
  }
}
